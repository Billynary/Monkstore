# Monkstore lab — environment template. Copy to .env and fill in.
# .env itself is gitignored and must never be committed.
PORT=3000
NODE_ENV=development

# Database. In Kubernetes these values come from a Secret, not this file.
POSTGRES_USER=monkstore
POSTGRES_PASSWORD=change-me-dev-password
POSTGRES_DB=monkstore
DATABASE_URL=postgresql://monkstore:change-me-dev-password@db:5432/monkstore?schema=public

# Auth — generate a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=generate-a-long-random-string

# Frontend origin (CORS)
FRONTEND_ORIGIN=http://localhost:8080

# Stripe — TEST mode keys only (see https://dashboard.stripe.com/test/apikeys).
# Never use live keys in this intentionally vulnerable app.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
