# Monkstore lab — environment template. Copy to .env and fill in.
# .env itself is gitignored and must never be committed.
#
# The SAME file shape is used locally and on the homelab host; there Ansible
# renders it from Vault (roles/home-monkstore/templates/monkstore.env.j2).
PORT=3000
NODE_ENV=development

# Database. `db` is the compose service name, so this URL is correct on every
# host the stack runs on.
POSTGRES_USER=monkstore
POSTGRES_PASSWORD=change-me-dev-password
POSTGRES_DB=monkstore
DATABASE_URL=postgresql://monkstore:change-me-dev-password@db:5432/monkstore?schema=public

# Auth — generate a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=generate-a-long-random-string

# Published host ports. Left unset, compose falls back to the local defaults
# (web 8081, api 3000, db 5432). The homelab host sets WEB_PORT=80.
WEB_PORT=8081
BACKEND_PORT=3000
DB_PORT=5432

# Frontend origin (CORS). Same-origin in practice, since nginx in the `web`
# container serves the SPA and proxies /api to the backend.
FRONTEND_ORIGIN=http://localhost:8081

# Stripe — TEST mode keys only (see https://dashboard.stripe.com/test/apikeys).
# Never use live keys in this intentionally vulnerable app. Left empty, the
# deposit flow uses its keyless "simulate" fallback.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
